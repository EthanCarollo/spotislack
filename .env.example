# Public URL used to build OAuth callback URLs. It must match both provider dashboards.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Spotify Developer Dashboard
NUXT_SPOTIFY_CLIENT_ID=
NUXT_SPOTIFY_CLIENT_SECRET=

# Slack App > OAuth & Permissions
NUXT_SLACK_CLIENT_ID=
NUXT_SLACK_CLIENT_SECRET=

# Long random value used to sign sessions and OAuth state.
NUXT_SESSION_SECRET=replace-with-a-long-random-secret

# Separate long random value used to encrypt provider tokens at rest.
NUXT_TOKEN_ENCRYPTION_KEY=replace-with-another-long-random-secret

# Secret required by the server-to-server cron endpoint.
NUXT_CRON_SECRET=replace-with-a-third-long-random-secret

# Optional path for the small encrypted JSON store used by the Node deployment.
# NUXT_STORAGE_PATH=.data/spotislack.json
